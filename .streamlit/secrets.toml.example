# Salin file ini menjadi .streamlit/secrets.toml (JANGAN di-commit ke GitHub)
# Di Streamlit Cloud: App settings > Secrets > paste isi file ini.

[supabase]
url = "https://xxxxxxxx.supabase.co"
key = "SERVICE_ROLE_KEY_DARI_SUPABASE"   # Project Settings > API > service_role

[users.admin]
name     = "Admin"
password = "ganti-password-admin"
role     = "admin"      # akses semua halaman, termasuk Upload Stock

[users.sales]
name     = "Tim Sales"
password = "ganti-password-sales"
role     = "user"       # Dashboard, Input Sell-in, Report
